# Personal stock portfolio — YOUR real holdings and cost basis.
# Never committed. Only holdings.example.json and README.md are tracked.
portfolio/holdings.json
portfolio/history.json

# Personal bond portfolio — YOUR real Treasury/Infrastructure bond holdings.
# Never committed. Only bonds.example.json and README.md are tracked.
portfolio/bonds.json
portfolio/bonds_history.json

# Personal international (US) stock portfolio — YOUR real holdings and cost basis.
# Never committed. Only international_holdings.example.json and README.md are tracked.
portfolio/international_holdings.json
portfolio/international_history.json

# Portfolio CSVs (holdings.csv, international_holdings.csv, bonds.csv,
# watchlist.csv) — the spreadsheet-friendly way to enter your holdings and the
# stocks you're watching. A catch-all on purpose: ANY .csv dropped into
# portfolio/ (including a raw broker export you saved there) is private by
# default. Only the *.example.csv templates are tracked.
portfolio/*.csv
!portfolio/*.example.csv

# Automatic safety copies the dashboard app takes before it removes or edits a
# row in one of your portfolio files — the same private data, so never committed.
portfolio/backups/